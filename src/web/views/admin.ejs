<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#101827" />
    <title>Sashimi · Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="/static/dashboard.css" rel="stylesheet" />
    <script src="/static/dashboard-live.js" defer></script>
  </head>
  <body class="min-vh-100" data-dashboard="admin">
    <nav class="navbar navbar-expand border-bottom border-secondary-subtle">
      <div class="container">
        <a href="/dashboard" class="navbar-brand fw-bold"><span class="text-primary">♫</span> Sashimi</a>
        <div class="d-flex align-items-center gap-3">
          <img class="avatar" src="<%= avatarUrl %>" alt="" width="36" height="36" />
          <span class="d-none d-sm-inline"><%= username %></span>
          <% if (isAdmin) { %>
            <a class="btn btn-outline-light btn-sm" href="/admin" aria-current="page">Admin</a>
          <% } %>
          <a class="btn btn-outline-light btn-sm" href="/logout">Log out</a>
        </div>
      </div>
    </nav>
    <main class="container admin-page py-4 py-md-5">
      <header class="admin-header">
        <div>
          <p class="text-primary text-uppercase fw-semibold small mb-2">Owner workspace</p>
          <h1 class="display-6 fw-bold mb-0">All bot servers</h1>
        </div>
        <a class="btn btn-outline-light" href="/dashboard">Back to dashboard</a>
      </header>
      <p class="text-secondary admin-description">A clear view of every server playing with Sashimi. Open a server to explore its activity and analytics.</p>
      <div class="admin-toolbar">
        <div><h2 class="h5 mb-1">Server directory</h2><span id="guild-total" class="small text-secondary"><%= guilds.length %> total</span></div>
        <p id="live-status" class="small text-secondary mb-0" role="status" aria-live="polite">Statistics refresh automatically.</p>
      </div>
      <section id="guild-list" class="row row-cols-1 row-cols-md-2 row-cols-xxl-3 g-4" aria-label="Bot servers">
        <% for (const guild of guilds) { %>
          <%- include('server-card', { guild, isAdmin: true }) %>
        <% } %>
        <% if (!guilds.length) { %><div class="col"><p class="text-secondary">Sashimi is not in any servers yet.</p></div><% } %>
      </section>
      <p class="small text-secondary mt-4">Totals since tracking began · Activity highlights cover the last 7 days · Storage excludes shared global cache.</p>
    </main>
  </body>
</html>

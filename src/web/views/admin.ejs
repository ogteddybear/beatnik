<!doctype html>
<html lang="en" data-bs-theme="dark">
  <head>
    <%- include('head', { title: 'Sashimi · Admin', live: true }) %>
  </head>
  <body class="min-vh-100" data-dashboard="admin">
    <%- include('navbar', { active: 'admin' }) %>
    <main class="container page-container">
      <header class="admin-header">
        <div>
          <p class="text-primary text-uppercase fw-semibold eyebrow mb-2">Owner workspace</p>
          <h1 class="display-6 fw-bold mb-0">All bot servers</h1>
        </div>
        <a class="btn btn-outline-light" href="/dashboard">Back to dashboard</a>
        <a class="btn btn-outline-light" href="/api/admin/export/events">Export Event Log (CSV)</a>
        <a class="btn btn-outline-light" href="/admin/bot">Bot settings</a>
      </header>
      <p class="text-secondary admin-description">Every server listening with Sashimi. Open a server to explore its activity and analytics.</p>
      <%- include('infrastructure', { infrastructure: typeof infrastructure === 'undefined' ? null : infrastructure }) %>
      <%- include('player-widget') %>
      <section class="panel page-section" aria-labelledby="event-search-heading">
        <h2 id="event-search-heading" class="h4">Search all event logs</h2>
        <form id="admin-search" class="d-flex gap-2">
          <label class="visually-hidden" for="event-search-query">Username, track name or action</label>
          <input id="event-search-query" class="form-control" type="search" maxlength="200" required placeholder="Username, track name or action…" />
          <button class="btn btn-primary" type="submit">Search</button>
        </form>
        <p id="event-search-status" role="status" aria-live="polite" class="mt-3">Search live and archived events. Up to 50 results per page.</p>
        <div class="table-responsive"><table class="table">
          <thead><tr><th>Time (UTC)</th><th>Server</th><th>Username</th><th>Track</th><th>Type</th><th>Action</th></tr></thead>
          <tbody id="event-search-results"></tbody>
        </table></div>
        <button id="event-search-more" class="btn btn-outline-light" type="button" hidden>Load more results</button>
      </section>
      <script src="/static/admin-search.js" defer></script>
      <div class="admin-toolbar">
        <div><h2 class="h5 mb-1">Server directory</h2><span id="guild-total" class="small text-secondary placeholder-glow"><span class="placeholder px-4" aria-hidden="true">&nbsp;</span></span></div>
        <p id="live-status" class="live-status mb-0" role="status" aria-live="polite" data-state="loading">Loading servers…</p>
      </div>
      <section id="guild-list" class="row row-cols-1 row-cols-md-2 row-cols-xxl-3 g-4" aria-label="Bot servers" aria-busy="true" data-initial="loading">
        <%- include('list-placeholders', { guilds, admin: true }) %>
        <% for (const guild of guilds) { %>
          <%- include('server-card', { guild, isAdmin: true }) %>
        <% } %>
        <% if (!guilds.length) { %><div class="col-12" data-empty><div class="empty-state">No servers yet. Invite Sashimi to a server to see it here.</div></div><% } %>
      </section>
      <p class="small text-secondary mt-4">Totals since tracking began · Highlights cover the last 7 days · Storage includes only audio saved for each server.</p>
    </main>
  </body>
</html>

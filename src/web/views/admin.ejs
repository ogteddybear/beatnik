<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#101827" />
    <title>Sashimi · Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="/static/dashboard.css" rel="stylesheet" />
    <script src="/static/dashboard-live.js" defer></script>
  </head>
  <body class="min-vh-100" data-dashboard="admin">
    <nav class="navbar navbar-expand border-bottom border-secondary-subtle">
      <div class="container">
        <a href="/dashboard" class="navbar-brand fw-bold"><span class="text-primary">♫</span> Sashimi</a>
        <div class="d-flex align-items-center gap-3">
          <img class="avatar" src="<%= avatarUrl %>" alt="" width="36" height="36" />
          <span class="d-none d-sm-inline"><%= username %></span>
          <% if (isAdmin) { %>
            <a class="btn btn-outline-light btn-sm" href="/admin" aria-current="page">Admin</a>
          <% } %>
          <a class="btn btn-outline-light btn-sm" href="/logout">Log out</a>
        </div>
      </div>
    </nav>
    <main class="container py-5">
      <header class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
          <p class="text-primary text-uppercase fw-semibold small mb-2">Bot owner · last 7 days</p>
          <h1 class="display-6 fw-bold mb-0">All bot servers</h1>
        </div>
        <a class="btn btn-outline-light" href="/dashboard">Back to dashboard</a>
      </header>
      <p class="text-secondary">Open a server for activity, filters, and longer-range statistics. Totals include events since tracking began.</p>
      <p id="live-status" class="small text-secondary" role="status" aria-live="polite">Loading server statistics…</p>
      <section id="guild-list" class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3" aria-label="Bot servers"></section>
    </main>
  </body>
</html>

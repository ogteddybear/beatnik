<!doctype html>
<html lang="en" data-bs-theme="dark">
  <head>
    <%- include('head', { title: 'Sashimi · Admin', live: true }) %>
  </head>
  <body class="min-vh-100" data-dashboard="admin">
    <%- include('navbar', { active: 'admin' }) %>
    <main class="container page-container">
      <header class="admin-header">
        <div>
          <p class="text-primary text-uppercase fw-semibold eyebrow mb-2">Admin</p>
          <h1 class="display-6 fw-bold mb-0">All bot servers</h1>
        </div>
        <div class="header-actions"><a class="btn btn-outline-secondary" href="/dashboard">Dashboard</a>
        <a class="btn btn-outline-secondary" href="/admin/statistics">Statistics</a>
        <a class="btn btn-outline-secondary" href="/admin/bot">Bot settings</a></div>
      </header>
      <%- include('infrastructure', { infrastructure: typeof infrastructure === 'undefined' ? null : infrastructure }) %>
      <%- include('player-widget') %>
      <div class="admin-toolbar">
        <div><h2 class="h5 mb-1">Server directory</h2><span id="guild-total" class="small text-secondary placeholder-glow"><span class="placeholder px-4" aria-hidden="true">&nbsp;</span></span></div>
        <p id="live-status" class="live-status mb-0" role="status" aria-live="polite" data-state="loading">Loading servers…</p>
      </div>
      <section id="guild-list" class="row row-cols-1 row-cols-md-2 row-cols-xxl-3 g-4" aria-label="Bot servers" aria-busy="true" data-initial="loading">
        <%- include('list-placeholders', { guilds, admin: true }) %>
        <% for (const guild of guilds) { %>
          <%- include('server-card', { guild, isAdmin: true }) %>
        <% } %>
        <% if (!guilds.length) { %><div class="col-12" data-empty><div class="empty-state">No servers yet. Invite Sashimi to a server to see it here.</div></div><% } %>
      </section>
    </main>
  </body>
</html>

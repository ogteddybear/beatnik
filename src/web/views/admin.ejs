<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#101827" />
    <title>Sashimi · Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="/static/dashboard.css" rel="stylesheet" />
  </head>
  <body class="min-vh-100">
    <nav class="navbar navbar-expand border-bottom border-secondary-subtle">
      <div class="container">
        <a href="/dashboard" class="navbar-brand fw-bold"><span class="text-primary">♫</span> Sashimi</a>
        <div class="d-flex align-items-center gap-3">
          <img class="avatar" src="<%= avatarUrl %>" alt="" width="36" height="36" />
          <span class="d-none d-sm-inline"><%= username %></span>
          <% if (isAdmin) { %>
            <a class="btn btn-outline-light btn-sm" href="/admin" aria-current="page">Admin</a>
          <% } %>
          <a class="btn btn-outline-light btn-sm" href="/logout">Log out</a>
        </div>
      </div>
    </nav>

    <main class="container py-5">
      <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
          <p class="text-primary text-uppercase fw-semibold small mb-2">Bot owner</p>
          <h1 class="display-6 fw-bold mb-0">Recent events</h1>
        </div>
        <a class="btn btn-outline-light" href="/dashboard">Back to dashboard</a>
      </div>
      <div class="card dashboard-card p-3 p-md-4">
        <div class="table-responsive">
          <table class="table table-dark table-striped table-hover align-middle mb-0">
            <thead>
              <tr>
                <th scope="col">Time</th>
                <th scope="col">Guild</th>
                <th scope="col">User</th>
                <th scope="col">Event Type</th>
                <th scope="col">Action</th>
                <th scope="col">Metadata</th>
              </tr>
            </thead>
            <tbody>
              <% if (events.length === 0) { %>
                <tr><td colspan="6" class="text-center py-4">No events recorded yet.</td></tr>
              <% } %>
              <% for (const event of events) { %>
                <tr>
                  <td class="text-nowrap"><time datetime="<%= event.time %>"><%= event.time %></time></td>
                  <td><%= event.guild %></td>
                  <td><%= event.user %></td>
                  <td><%= event.eventType %></td>
                  <td><%= event.action %></td>
                  <td class="text-break"><code><%= event.metadata %></code></td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </main>
  </body>
</html>

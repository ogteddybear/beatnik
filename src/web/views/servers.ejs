<!doctype html>
<html lang="en" data-bs-theme="dark">
<head><%- include('head', { title: 'Servers · Sashimi', live: false }) %></head>
<body class="min-vh-100">
  <%- include('navbar', { active: 'servers' }) %>
  <main class="container page-container">
    <h1 class="h2">Your servers</h1>
    <section class="panel page-section" aria-label="Cross-server totals">
      <dl class="metric-grid">
        <div><dt>Total plays</dt><dd><%= overview.totalPlays %></dd></div>
        <div><dt>Servers</dt><dd><%= guilds.length %></dd></div>
        <div><dt>Top requested track</dt><dd class="fs-6"><%= overview.topTrack?.title ?? 'No requests yet' %></dd></div>
      </dl>
    </section>
    <section class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4" aria-label="Managed servers">
      <% for (const guild of guilds) { %>
        <div class="col"><article class="card dashboard-card p-4 h-100">
          <h2 class="h4 text-break"><%= guild.name %></h2>
          <p class="text-body-secondary small tabular-nums"><%= guild.plays %> plays</p>
          <p class="text-break small"><span class="text-body-secondary">Top track</span><br /><%= guild.topTrack?.title ?? 'No requests yet' %></p>
          <a class="btn btn-outline-secondary mt-auto align-self-start" href="/dashboard/guilds/<%= encodeURIComponent(guild.id) %>">Queue &amp; settings →</a>
        </article></div>
      <% } %>
      <% if (!guilds.length) { %><div class="col-12"><p class="empty-state mb-0">No servers yet. Invite Sashimi to a server you manage.</p></div><% } %>
    </section>
  </main>
</body></html>

<!doctype html><html lang="en" data-bs-theme="dark">
<head><%- include('head', { title: 'Your recap · Sashimi', live: false }) %></head>
<body><%- include('navbar', { active: 'recap' }) %>
<main class="container page-container"><h1>Your 30-day recap</h1>
<section class="panel page-section">
<dl class="metric-grid">
  <div><dt>Your queued plays</dt><dd><%= recap.plays %></dd></div>
  <div><dt>Top track</dt><dd class="fs-6"><%= recap.topTrack?.name ?? 'No plays yet' %></dd></div>
  <div><dt>Top artist / channel</dt><dd class="fs-6"><%= recap.topArtist?.name ?? 'Not recorded yet' %></dd></div>
  <div><dt>Estimated track duration</dt><dd><%= Math.round((recap.durationSeconds ?? 0) / 60) %> <span class="fs-6 fw-normal text-body-secondary">min</span></dd></div>
</dl>
<p class="small text-body-secondary mt-4 mb-0">Based on <%= recap.measuredPlays %> of <%= recap.plays %> plays with known durations. Includes skipped tracks; not actual listening time.</p>
</section></main></body></html>

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#101827" />
    <title>Sashimi · Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="/static/dashboard.css" rel="stylesheet" />
  </head>
  <body class="min-vh-100">
    <nav class="navbar navbar-expand border-bottom border-secondary-subtle">
      <div class="container">
        <a href="/dashboard" class="navbar-brand fw-bold"><span class="text-primary">♫</span> Sashimi</a>
        <div class="d-flex align-items-center gap-3">
          <img class="avatar" src="<%= avatarUrl %>" alt="" width="36" height="36" />
          <span class="d-none d-sm-inline"><%= username %></span>
          <% if (isAdmin) { %>
            <a class="btn btn-outline-light btn-sm" href="/admin">Admin</a>
          <% } %>
          <a class="btn btn-outline-light btn-sm" href="/logout">Log out</a>
        </div>
      </div>
    </nav>

    <main class="container py-5">
      <header class="d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-3 mb-5">
        <div>
          <p class="text-primary text-uppercase fw-semibold small mb-2">Your dashboard</p>
          <h1 class="display-6 fw-bold">Welcome back, <%= username %></h1>
          <p class="text-secondary mb-0">Servers you manage where Sashimi is installed.</p>
        </div>
        <a class="btn btn-primary btn-lg" href="<%= inviteUrl %>">Invite Sashimi</a>
      </header>

      <section aria-labelledby="servers-heading">
        <div class="d-flex align-items-baseline justify-content-between mb-3">
          <h2 class="h4 fw-bold" id="servers-heading">Your servers</h2>
          <span class="text-secondary"><%= guilds.length %> total</span>
        </div>
        <% if (guilds.length === 0) { %>
          <div class="card dashboard-card p-4 text-secondary">
            No eligible servers found. Manage a server where Sashimi is installed, or invite Sashimi to one.
          </div>
        <% } else { %>
          <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3">
            <% for (const guild of guilds) { %>
              <div class="col">
                <article class="card dashboard-card h-100 p-4">
                  <div class="d-flex align-items-center gap-3 mb-4">
                    <% if (guild.iconUrl) { %>
                      <img class="guild-icon" src="<%= guild.iconUrl %>" alt="" width="56" height="56" loading="lazy" />
                    <% } else { %>
                      <div class="guild-icon guild-placeholder" aria-hidden="true"><%= guild.name.charAt(0).toUpperCase() %></div>
                    <% } %>
                    <h3 class="h5 fw-semibold mb-0 text-break"><%= guild.name %></h3>
                  </div>
                  <div class="row row-cols-2 row-cols-md-3 g-3 text-center mb-3">
                    <div class="col">
                      <p class="h5 fw-semibold mb-0"><%= guild.plays %></p>
                      <p class="small text-secondary mb-0">Plays</p>
                    </div>
                    <div class="col">
                      <p class="h5 fw-semibold mb-0"><%= guild.requests %></p>
                      <p class="small text-secondary mb-0">Requests</p>
                    </div>
                    <div class="col">
                      <p class="h5 fw-semibold mb-0"><%= guild.storageUsed %></p>
                      <p class="small text-secondary mb-0">Storage</p>
                    </div>
                    <div class="col">
                      <p class="h5 fw-semibold mb-0"><%= guild.skips %></p>
                      <p class="small text-secondary mb-0">Skips</p>
                    </div>
                    <div class="col">
                      <p class="h5 fw-semibold mb-0"><%= guild.stops %></p>
                      <p class="small text-secondary mb-0">Stops</p>
                    </div>
                    <div class="col">
                      <p class="h5 fw-semibold mb-0"><%= guild.commands %></p>
                      <p class="small text-secondary mb-0">Commands</p>
                    </div>
                  </div>
                  <p class="small text-secondary mb-0">
                    Cached audio stored in this server's directory. Shared legacy files in global/ are excluded.
                  </p>
                </article>
              </div>
            <% } %>
          </div>
        <% } %>
      </section>
    </main>
  </body>
</html>

<!doctype html>
<html lang="en" data-bs-theme="dark">
  <head>
    <%- include('head', { title: 'Sashimi · Dashboard', live: true }) %>
  </head>
  <body class="min-vh-100" data-dashboard="regular">
    <%- include('navbar', { active: 'dashboard' }) %>

    <main class="container page-container">
      <header class="page-header">
        <div>
          <p class="text-primary text-uppercase fw-semibold eyebrow mb-2">Your dashboard</p>
          <h1 class="display-6 fw-bold">Welcome back, <%= username %></h1>
        </div>
        <a class="btn btn-primary btn-lg" href="<%= inviteUrl %>">Invite Sashimi</a>
      </header>
      <p id="live-status" class="live-status mb-4" role="status" aria-live="polite" data-state="loading">Loading your servers…</p>
      <%- include('player-widget') %>
      <%- include('spotify-account', { account: typeof spotifyAccount === 'undefined' ? null : spotifyAccount }) %>
      <%- include('statistics', { statisticsUrl: '/api/dashboard/statistics' }) %>

      <section aria-labelledby="servers-heading">
        <div class="d-flex align-items-baseline justify-content-between mb-3">
          <h2 class="h4 fw-bold" id="servers-heading">Your servers</h2>
          <span id="guild-total" class="text-secondary placeholder-glow"><span class="placeholder px-4" aria-hidden="true">&nbsp;</span></span>
        </div>
        <div id="guild-list" class="row row-cols-1 row-cols-md-2 row-cols-xxl-3 g-4" aria-busy="true" data-initial="loading">
          <%- include('list-placeholders', { guilds, admin: false }) %>
          <% if (guilds.length === 0) { %>
            <div class="col-12" data-empty><div class="empty-state">No servers to show. You’ll see servers you manage once Sashimi has joined them.</div></div>
          <% } else { %>
            <% for (const guild of guilds) { %>
              <%- include('server-card', { guild, isAdmin: false }) %>
            <% } %>
          <% } %>
        </div>
      </section>
    </main>
  </body>
</html>

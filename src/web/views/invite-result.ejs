<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Sashimi · Bot installation</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="/static/dashboard.css" rel="stylesheet" />
  </head>
  <body class="d-flex min-vh-100 align-items-center justify-content-center">
    <main class="container py-5">
      <div class="card dashboard-card mx-auto text-center p-4 p-md-5" style="max-width: 540px">
        <h1 class="h2 fw-bold">Sashimi installation</h1>
        <p role="status"><%= message %></p>
        <a class="btn btn-primary" href="<%= isAuthenticated ? '/dashboard' : '/' %>"><%= isAuthenticated ? 'View dashboard' : 'Return to Sashimi' %></a>
      </div>
    </main>
  </body>
</html>

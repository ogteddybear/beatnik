<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#101827" />
    <title><%= guildName %> · Sashimi analytics</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="/static/dashboard.css" rel="stylesheet" />
    <script src="/static/dashboard-live.js" defer></script>
  </head>
  <body class="min-vh-100" data-dashboard="detail" data-guild-id="<%= guildId %>">
    <nav class="navbar navbar-expand border-bottom border-secondary-subtle">
      <div class="container">
        <a href="/dashboard" class="navbar-brand fw-bold"><span class="text-primary">♫</span> Sashimi</a>
        <div class="d-flex align-items-center gap-3">
          <img class="avatar" src="<%= avatarUrl %>" alt="" width="36" height="36" />
          <span class="d-none d-sm-inline"><%= username %></span>
          <% if (isAdmin) { %>
            <a class="btn btn-outline-light btn-sm" href="/admin">Admin</a>
          <% } %>
          <a class="btn btn-outline-light btn-sm" href="/logout">Log out</a>
        </div>
      </div>
    </nav>
    <main class="container py-5">
      <a href="/admin" class="d-inline-block mb-3">← All servers</a>
      <h1 class="display-6 fw-bold"><%= guildName %></h1>
      <p class="text-secondary">Server ID: <%= guildId %> · Requests are queued tracks; plays are successful stream handoffs. Errors are recorded failures, not failed commands inferred from invocations.</p>
      <p id="live-status" class="small text-secondary" role="status" aria-live="polite">Loading analytics…</p>
      <section aria-label="Server statistics" class="mb-5">
        <h2 class="h4">Event counts by time range</h2>
        <div class="table-responsive">
          <table class="table table-dark table-striped">
            <thead><tr><th>Range</th><th>Plays</th><th>Requests</th><th>Library adds</th><th>Skips</th><th>Stops</th><th>Commands</th><th>Errors</th></tr></thead>
            <tbody id="range-stats"></tbody>
          </table>
        </div>
        <p id="all-time" class="text-secondary"></p>
        <p id="storage" class="text-secondary"></p>
      </section>
      <section aria-labelledby="activity-heading">
        <h2 id="activity-heading" class="h4">Recent activity</h2>
        <form id="activity-filters" class="row g-2 align-items-end mb-3">
          <div class="col-6 col-lg-2">
            <label class="form-label" for="range">Range</label>
            <select class="form-select" id="range" name="range">
              <option value="1">Last 24 hours</option>
              <option value="7" selected>Last 7 days</option>
              <option value="30">Last 30 days</option>
              <option value="custom">Custom (max 90 days)</option>
            </select>
          </div>
          <div class="col-6 col-lg-2">
            <label class="form-label" for="from">From (UTC)</label>
            <input class="form-control" id="from" name="from" type="date" />
          </div>
          <div class="col-6 col-lg-2">
            <label class="form-label" for="to">Through (UTC)</label>
            <input class="form-control" id="to" name="to" type="date" />
          </div>
          <div class="col-6 col-lg-2">
            <label class="form-label" for="type">Event type</label>
            <select class="form-select" id="type" name="type">
              <option value="">All</option><option value="command">Command</option>
              <option value="player">Player</option><option value="command_error">Command error</option>
              <option value="player_error">Player error</option><option value="library">Library</option>
            </select>
          </div>
          <div class="col-6 col-lg-2">
            <label class="form-label" for="action">Search action / command</label>
            <input class="form-control" id="action" name="action" maxlength="64" placeholder="play, skip…" />
          </div>
          <div class="col-6 col-lg-2">
            <label class="form-label" for="user">User ID</label>
            <input class="form-control" id="user" name="user" inputmode="numeric" maxlength="20" />
          </div>
          <div class="col-12"><button class="btn btn-primary" type="submit">Apply filters</button></div>
        </form>
        <div class="table-responsive">
          <table class="table table-dark table-striped align-middle">
            <thead><tr><th>Time</th><th>User</th><th>Event type</th><th>Action</th><th>Details</th></tr></thead>
            <tbody id="activity-rows"></tbody>
          </table>
        </div>
        <button id="load-older" class="btn btn-outline-light" type="button" hidden>Load older events</button>
      </section>
    </main>
  </body>
</html>

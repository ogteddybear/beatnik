<section class="card dashboard-card p-4 mb-4" id="infrastructure-health" aria-labelledby="infrastructure-heading">
  <h2 class="h4 mb-3" id="infrastructure-heading">Infrastructure Health</h2>
  <div class="row g-4">
    <div class="col-12 col-sm-6 col-xl-3">
      <h3 class="h6 text-secondary">Uptime</h3>
      <p class="mb-0" data-infra-uptime><%= infrastructure?.uptime ?? 'Unavailable' %></p>
    </div>
    <% for (const [key, label] of [['memory', 'Process RAM'], ['cpu', 'CPU Load'], ['volume', 'Volume Storage']]) {
      const metric = infrastructure?.[key];
      const percentage = metric?.percentage;
    %>
    <div class="col-12 col-sm-6 col-xl-3">
      <h3 class="h6 text-secondary"><%= label %></h3>
      <p class="mb-1 <%= percentage == null ? 'text-secondary' : '' %>" data-infra-value="<%= key %>"><%= metric?.text ?? 'Unavailable' %></p>
      <div data-infra-meter="<%= key %>" <%= percentage == null ? 'hidden' : '' %>>
        <div class="progress mt-2" role="progressbar" aria-label="<%= label %>"
             aria-valuemin="0" aria-valuemax="100"
             aria-valuenow="<%= Math.max(0, Math.min(100, percentage ?? 0)) %>"
             aria-valuetext="<%= Math.round(percentage ?? 0) %>%" style="height: 6px;">
          <div class="progress-bar <%= (percentage ?? 0) > 90 ? 'bg-danger' : 'bg-primary' %>"
               style="width: <%= Math.max(0, Math.min(100, percentage ?? 0)) %>%"></div>
        </div>
      </div>
    </div>
    <% } %>
  </div>
  <p class="small text-secondary mt-3 mb-0">CPU is a load-average estimate, not measured utilization. Load 1/5/15m:
    <span data-infra-load><%= infrastructure?.loadAverage ?? 'Unavailable' %></span> ·
    <span data-infra-cores><%= infrastructure?.coreCount ?? '—' %></span> cores.
    Volume source: <span data-infra-source><%= infrastructure?.volumeSource ?? 'Unavailable' %></span>.
    Refreshes every 15 seconds while visible.
  </p>
</section>

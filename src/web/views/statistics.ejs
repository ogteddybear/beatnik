<section id="statistics" class="page-section statistics-overview" aria-labelledby="statistics-heading" data-statistics-url="<%= statisticsUrl %>" aria-busy="true">
  <div class="statistics-toolbar">
    <h2 id="statistics-heading" class="h4">Statistics · Last 30 days</h2>
    <div class="statistics-controls">
      <label class="visually-hidden" for="statistics-source">Source</label>
      <select id="statistics-source" class="form-select form-select-sm">
        <option value="queue">Queued playback</option>
        <option value="radio">Radio</option>
        <option value="all">All sources</option>
      </select>
      <button id="refresh-statistics" class="btn btn-sm btn-outline-secondary" type="button" aria-label="Refresh statistics">Refresh</button>
    </div>
  </div>
  <p id="statistics-status" class="small text-secondary" role="status" aria-live="polite">Loading statistics…</p>
  <div class="row row-cols-1 row-cols-sm-2 row-cols-xl-4 g-3 mb-3" aria-label="30-day totals">
    <% for (const [index, label] of ['Plays', 'Commands', 'Skips', 'Errors'].entries()) { %>
    <div class="col"><div class="panel statistics-kpi h-100">
      <p class="small text-body-secondary mb-2" data-statistic-label="<%= index %>"><%= label %></p>
      <p class="statistics-kpi-value tabular-nums placeholder-glow mb-0" data-statistic-value="<%= index %>"><span class="placeholder col-6" aria-hidden="true"></span><span class="visually-hidden">Loading</span></p>
    </div></div>
    <% } %>
  </div>
  <div class="row g-3">
    <div class="col-12 col-lg-8"><section class="panel h-100 statistics-chart-panel" aria-labelledby="statistics-plays-heading">
      <h3 id="statistics-plays-heading" class="h6 mb-3">Plays over time</h3>
      <div class="statistics-chart statistics-chart-line"><canvas id="plays-chart" role="img" aria-label="Plays over the last 30 days; values are in the data table below"></canvas></div>
    </section></div>
    <div class="col-12 col-lg-4"><section class="panel h-100 statistics-chart-panel" aria-labelledby="statistics-distribution-heading">
      <h3 id="statistics-distribution-heading" class="h6 mb-3">Commands / plays / skips</h3>
      <div class="statistics-chart statistics-chart-doughnut"><canvas id="distribution-chart" role="img" aria-label="Commands, plays and skips distribution; totals are below"></canvas></div>
      <ul id="distribution-legend" class="statistics-legend list-unstyled small mb-0 mt-3" aria-label="Breakdown"></ul>
    </section></div>
    <div class="col-12"><section class="panel statistics-chart-panel" aria-labelledby="statistics-tracks-heading">
      <h3 id="statistics-tracks-heading" class="h6 mb-3">Top 10 requested tracks</h3>
      <div class="statistics-chart statistics-chart-tracks"><canvas id="tracks-chart" role="img" aria-label="Top requested tracks; values are listed below"></canvas></div>
    </section></div>
  </div>
  <details class="mt-4"><summary class="small text-body-secondary">View statistics data</summary>
    <div id="radio-statistics-details" hidden>
      <p id="radio-statistics-summary" class="small text-body-secondary tabular-nums mt-3"></p>
    </div>
    <div id="distribution-data" class="row row-cols-2 g-2 g-md-3 mt-3 mb-3" aria-label="Activity totals"></div>
    <h3 id="statistics-track-list-heading" class="h6 mt-4 mb-3">Top tracks</h3>
    <ol id="top-tracks-data" class="list-group list-group-flush statistics-ranked-list mb-4"></ol>
    <div id="radio-statistics-breakdown" hidden>
      <h3 class="h6 mb-3">Stations</h3><ul id="radio-stations-data" class="list-group list-group-flush statistics-ranked-list mb-4"></ul>
      <h3 class="h6 mb-3">Top artists</h3><ol id="radio-artists-data" class="list-group list-group-flush statistics-ranked-list mb-4"></ol>
    </div>
    <section class="panel mt-3" aria-labelledby="statistics-daily-heading">
      <div class="d-flex align-items-center justify-content-between gap-2 mb-3">
        <h3 id="statistics-daily-heading" class="h6 mb-0">Daily activity</h3>
        <span class="badge statistics-timezone">UTC</span>
      </div>
      <div class="table-responsive statistics-daily-scroll" role="region" aria-labelledby="statistics-daily-heading" tabindex="0">
        <table class="table table-hover align-middle mb-0 tabular-nums statistics-daily-table">
          <caption id="statistics-table-caption" class="visually-hidden">Daily plays, skips, errors and commands (UTC)</caption>
          <thead class="sticky-top"><tr id="statistics-columns"><th scope="col">Day</th><th scope="col" class="text-end">Plays</th><th scope="col" class="text-end">Skips</th><th scope="col" class="text-end">Errors</th><th scope="col" class="text-end">Commands</th></tr></thead>
          <tbody id="statistics-data"></tbody>
        </table>
      </div>
    </section>
  </details>
</section>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.8/dist/chart.umd.min.js" defer></script>
<script src="/static/statistics.js" defer></script>

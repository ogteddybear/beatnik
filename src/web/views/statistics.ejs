<section id="statistics" class="page-section panel" aria-labelledby="statistics-heading" data-statistics-url="<%= statisticsUrl %>">
  <h2 id="statistics-heading" class="h4">Statistics · Last 30 days</h2>
  <p class="small text-secondary">UTC calendar days, including today. Requests are grouped by recorded track title; older requests without titles are excluded.</p>
  <p id="statistics-status" role="status" aria-live="polite">Loading statistics…</p>
  <button id="refresh-statistics" class="btn btn-outline-light mb-3" type="button">Refresh statistics</button>
  <div class="row g-4">
    <div class="col-12"><h3 class="h6">Plays over time</h3><div class="statistics-chart statistics-chart-line"><canvas id="plays-chart" role="img" aria-label="Plays over the last 30 days; values are in the data table below"></canvas></div></div>
    <div class="col-12 col-lg-7"><h3 class="h6">Top 10 requested tracks</h3><div class="statistics-chart statistics-chart-tracks"><canvas id="tracks-chart" role="img" aria-label="Top requested tracks; values are listed below"></canvas></div></div>
    <div class="col-12 col-lg-5"><h3 class="h6">Commands / plays / skips</h3><div class="statistics-chart"><canvas id="distribution-chart" role="img" aria-label="Commands, plays and skips distribution; totals are below"></canvas></div></div>
  </div>
  <details class="mt-4"><summary>View statistics data</summary>
    <p id="distribution-data" class="mt-3"></p>
    <ol id="top-tracks-data"></ol>
    <div class="table-responsive"><table class="table table-striped">
      <caption>Daily plays, skips, errors and commands (UTC)</caption>
      <thead><tr><th scope="col">Day</th><th scope="col">Plays</th><th scope="col">Skips</th><th scope="col">Errors</th><th scope="col">Commands</th></tr></thead>
      <tbody id="statistics-data"></tbody>
    </table></div>
  </details>
</section>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.8/dist/chart.umd.min.js" defer></script>
<script src="/static/statistics.js" defer></script>

<!doctype html>
<html lang="en" data-bs-theme="dark">
  <head>
    <%- include('head', { title: 'Sashimi · Sign in', live: false }) %>
  </head>
  <body class="d-flex min-vh-100 align-items-center justify-content-center">
    <main class="container page-container">
      <div class="card dashboard-card auth-card mx-auto text-center p-4 p-md-5">
        <div class="brand-mark mx-auto mb-4" aria-hidden="true">♫</div>
        <h1 class="fw-bold mb-3">Your music, together.</h1>
        <p class="text-secondary mb-4">
          Sign in to see your servers, recent listening activity, and audio storage.
        </p>
        <a class="btn btn-primary btn-lg w-100" href="/auth/discord">Sign in with Discord</a>
        <a class="btn btn-outline-light mt-3 w-100" href="<%= inviteUrl %>">Invite Sashimi</a>
        <p class="small text-secondary mt-4 mb-0">Sign-in uses only your Discord profile and server list.</p>
      </div>
    </main>
  </body>
</html>

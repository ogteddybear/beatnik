<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#101827" />
    <title>Sashimi · Sign in</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="/static/dashboard.css" rel="stylesheet" />
  </head>
  <body class="d-flex min-vh-100 align-items-center justify-content-center">
    <main class="container py-5">
      <div class="card dashboard-card mx-auto text-center p-4 p-md-5" style="max-width: 480px">
        <div class="brand-mark mx-auto mb-4" aria-hidden="true">♫</div>
        <h1 class="h2 fw-bold mb-2">Sashimi</h1>
        <p class="text-secondary mb-4">
          Your servers, your music. Sign in to see where Sashimi is playing and how much space the bot uses.
        </p>
        <a class="btn btn-primary btn-lg w-100" href="/auth/discord">Login with Discord</a>
        <p class="small text-secondary mt-4 mb-0">Only your profile and server list are requested.</p>
      </div>
    </main>
  </body>
